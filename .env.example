# Demo engine: 'mock' runs the whole UI without the Family Controls
# entitlement (used for CI, previews and simulators).
EXPO_PUBLIC_ENGINE=mock

# Apple Developer Team ID, read by app.config.ts. Put the real value into a
# local .env (gitignored) or register it for EAS with `eas env:create`.
APPLE_TEAM_ID=TODO_APPLE_TEAM_ID
